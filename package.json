{
  "name": "tdbr",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "esbuild client/src/main.js --bundle --outfile=client/public/bundle.js --format=iife --platform=browser --external:phaser",
    "start": "node server/index.js",
    "dev": "npm run build && npm start",
    "watch": "esbuild client/src/main.js --bundle --outfile=client/public/bundle.js --format=iife --platform=browser --external:phaser --watch=forever",
    "test:multiplayer": "node tools/test-twinwire.mjs"
  },
  "dependencies": {
    "esbuild": "^0.25.0",
    "pathfinding": "^0.4.18",
    "rot-js": "^2.2.1",
    "twinwire": "2.2.0"
  },
  "optionalDependencies": {
    "node-datachannel": "0.33.4"
  }
}
